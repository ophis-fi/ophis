// Cloudflare Pages Functions are compiled server-side by Cloudflare at deploy
// time, so they are deliberately excluded from the build manifest (ci.yml) and
// belong to no package workspace. That left them typechecked by nothing: a bare
// `Cannot find name` shipped to production undetected (the `isolateHits`
// ReferenceError in api/bungee, 2026-07-13 -> 2026-07-25). This config exists
// solely so `pnpm typecheck:functions` covers them in CI.
{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "types": ["@cloudflare/workers-types"],
    "lib": ["ES2022", "WebWorker"]
  },
  "include": ["**/*.ts"]
}
