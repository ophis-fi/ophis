# Sovereign eRPC proxy for Robinhood Chain mainnet (chain 4663).
#
# Cadia's self-hosted Nitro node is the ONLY authoritative upstream. This is an
# explicit zero-budget posture: exhausted or rate-limited provider accounts are
# not redundancy and must never participate in settlement-critical reads.
#
# Robinhood's public RPC remains useful for out-of-band node monitoring (see
# nitro/verify-snapshot.sh), but it is deliberately absent from this project.
# If the self-node is unavailable, requests fail closed and settlement pauses.
# Real RPC high availability requires a second independently hosted Nitro node.
#
# Endpoint exposed: http://rpc-proxy:4000/main/evm/4663

logLevel: warn

projects:
  - id: main

    networks:
      - architecture: evm
        evm:
          chainId: 4663
          integrity:
            enforceHighestBlock: true
            enforceNonNullTaggedBlocks: true
        failsafe:
          - matchMethod: "*"
            timeout:
              duration: 30s
            retry:
              maxAttempts: 3
              delay: 200ms
              backoffMaxDelay: 1s
              backoffFactor: 1.5
              jitter: 50ms

    upstreamDefaults:
      evm:
        statePollerInterval: 1s
        statePollerDebounce: 300ms

    upstreams:
      - id: ophis-self-rbh
        endpoint: http://ophis-rbh-node:8547
        failsafe:
          - matchMethod: "*"
            timeout:
              duration: 30s
            retry:
              maxAttempts: 3
              delay: 200ms
              backoffMaxDelay: 1s
              backoffFactor: 1.5
              jitter: 50ms
