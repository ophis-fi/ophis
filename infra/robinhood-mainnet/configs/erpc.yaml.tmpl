# Zero-budget eRPC proxy for Robinhood Chain mainnet (chain 4663).
#
# READ AUTHORITY: 2-of-2 consensus between Cadia Nitro and Robinhood's official
# public RPC. Cadia was restored from a third-party snapshot whose flat
# state cannot be proven from the header anchor alone, so it must never be the
# sole authority for balances, code, storage, calls, logs, transaction data, or
# receipts. The official endpoint is free and requires no provider credential.
#
# TRACES: debug_* is self-node-only because the managed endpoint does not expose
# it. If Cadia is unavailable, trace-dependent settlement fails closed.
#
# TRANSACTION RELAY: Cadia Nitro forwards writes to Robinhood's official public
# endpoint via --execution.forwarding-target. eRPC can also submit directly to
# that endpoint.

logLevel: warn

projects:
  - id: main

    networks:
      - architecture: evm
        evm:
          chainId: 4663
          # Robinhood's official gateway does not expose eth_syncing, so eRPC's
          # state poller can trail its real head. Forward the concrete block
          # request and let 2-of-2 consensus fail closed on a missing result.
          enforceBlockAvailability: false
          # Pin latest-tagged reads and block-head responses to the freshest tip
          # both voters have observed. This avoids treating normal head skew as
          # a dispute while preserving strict 2-of-2 result agreement.
          servedTip:
            enabledFor:
              - latest
          integrity:
            # Do not exclude a voter merely for being a few fast Robinhood blocks
            # behind. Consensus compares the requested block's response; latest-
            # tag disagreement still returns an error under 2-of-2.
            enforceHighestBlock: false
            enforceNonNullTaggedBlocks: true
        # The public gateway must expose its head methods to its own eRPC state
        # poller so it can become an eligible consensus voter. Application head
        # reads remain self-node-only: strict equality at `latest` is impossible
        # on this fast chain and these values drive auction deadlines.
        selectionPolicy:
          evalScope: network-method
          evalFunc: |
            (upstreams, ctx) => {
              if (ctx.method === 'eth_blockNumber' || ctx.method === 'eth_getBlockByNumber') {
                return upstreams.filter((upstream) => upstream.id === 'ophis-self-rbh')
              }
              return upstreams
                .removeCordoned()
                .whenEmpty(() => upstreams)
                .sortByScore(PREFER_FASTEST)
            }
        failsafe:
          - matchMethod: "eth_call|eth_getBalance|eth_getCode|eth_getStorageAt|eth_estimateGas|eth_feeHistory|eth_getTransactionCount|eth_getBlockByHash|eth_getTransactionByHash|eth_getTransactionReceipt"
            timeout:
              duration: 12s
            consensus:
              maxParticipants: 2
              agreementThreshold: 2
              # Give the independent public voter a bounded completion window
              # instead of cancelling it when the local result arrives first.
              maxWaitOnResult: 5s
              # eRPC arms this cap on the first response of any kind. Keep it
              # aligned with maxWaitOnResult so its 50ms default cannot cancel
              # the second voter before quorum forms.
              maxWaitOnEmpty: 5s
              disputeBehavior: returnError
              lowParticipantsBehavior: returnError

          # HEDGE (2026-08-15, per-upstream-budget fix, see the OP template for
          # the incident record): a silently hanging lane on this sequential
          # path otherwise burns the whole network budget before failover —
          # A/B-proven on erpc 0.0.64 (12/12 x ~12s failures vs 18/18 OK at
          # ~1.1s). Here the hang-capable lane is robinhood-official (remote
          # CDN); ophis-self-rbh shares the Cadia host with this proxy and
          # dies WITH it, so hedging mostly protects against official-gateway
          # stalls.
          - matchMethod: "*"
            timeout:
              duration: 30s
            retry:
              maxAttempts: 3
              delay: 200ms
              backoffMaxDelay: 1s
              backoffFactor: 1.5
              jitter: 50ms
            hedge:
              delay: 1s
              maxCount: 1

    upstreamDefaults:
      evm:
        # Keep servedTip observations aligned with autopilot's one-second block
        # poll. A slower voter cadence would make protected latest-tagged state
        # reads authoritative at a stale common tip on this ~134 ms chain.
        statePollerInterval: 1s
        statePollerDebounce: 1s

    upstreams:
      - id: ophis-self-rbh
        endpoint: http://ophis-rbh-node:8547
        failsafe:
          # debug/trace keep the long budget: the autopilot REQUIRES
          # debug_traceTransaction (README — "Autopilot stops settling /
          # debug_traceTransaction errors") and this Nitro self-node is the
          # ONLY lane serving it, so there is no failover to protect and a
          # short generic timeout would cancel large-settlement traces and
          # pause settlement. Single attempt: retrying a long trace inside
          # the 30s network budget is pure waste. First-match: these pinned
          # rules must stay above the generic one.
          - matchMethod: "debug_*|trace_*"
            timeout:
              duration: 30s
            retry:
              maxAttempts: 1
          # eth_getLogs keeps the long budget: the official gateway ignores it
          # (429 storms on the permanent log stream), so this is the ONLY lane
          # serving logs — no failover exists to protect.
          - matchMethod: "eth_getLogs"
            timeout:
              duration: 30s
            retry:
              maxAttempts: 1
          # BUDGET INVARIANT (2026-08-15): one lane's worst-case serial budget
          # (attempts x timeout + backoff = 4x2+1 = 9s) must stay under the
          # smallest network timeout (12s consensus) so a wedged lane can
          # never starve requests before failover — the 2026-08-14 OP outage
          # class. Breaker ejects clean-error floods (the official gateway's
          # 429 pattern); hangs are covered by the catch-all hedge.
          - matchMethod: "*"
            timeout:
              duration: 4s
            retry:
              maxAttempts: 2
              delay: 200ms
              backoffMaxDelay: 1s
              backoffFactor: 1.5
              jitter: 50ms
            circuitBreaker:
              failureThresholdCount: 12
              failureThresholdCapacity: 24
              halfOpenAfter: 30s
              successThresholdCount: 2
              successThresholdCapacity: 4

      - id: robinhood-official
        endpoint: https://rpc.mainnet.chain.robinhood.com
        # Block-head inputs are restricted to Cadia by the per-method selection
        # policy above. Do not ignore them here: this upstream's private state
        # poller needs those methods to establish its served tip.
        ignoreMethods:
          # Robinhood produces ~7.5 blocks/s and autopilot indexes each canonical
          # block by hash. The free gateway cannot sustain that permanent log
          # stream and its 429s previously rejected otherwise-valid Kyber routes.
          # Keep settlement state/simulation reads 2-of-2 while the independent
          # genesis node derives; switch logs to the two local verified nodes at
          # promotion time.
          - eth_getLogs
        failsafe:
          # Same budget invariant as ophis-self-rbh's generic rule (9s < 12s).
          # This remote lane is the one that can silently hang while the local
          # stack survives — the exact 08-14 OP failure shape.
          - matchMethod: "*"
            timeout:
              duration: 4s
            retry:
              maxAttempts: 2
              delay: 200ms
              backoffMaxDelay: 1s
              backoffFactor: 1.5
              jitter: 50ms
            circuitBreaker:
              failureThresholdCount: 12
              failureThresholdCapacity: 24
              halfOpenAfter: 30s
              successThresholdCount: 2
              successThresholdCapacity: 4
