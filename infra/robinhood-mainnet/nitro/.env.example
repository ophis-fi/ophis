# infra/robinhood-mainnet/nitro/.env.example
# COPY to .env, fill in, chmod 600, NEVER COMMIT. (.env is gitignored.)
#
# The Nitro node validates Robinhood Chain (chainId 4663) by reading its batches
# and EIP-4844 blob DA from Ethereum L1. Both endpoints below are REQUIRED.

# ── L1 execution RPC (Ethereum mainnet JSON-RPC) ──────────────────────────────
# Nitro reads the Robinhood SequencerInbox batches from here. Prefer your own
# Ethereum node. Free fallback (rate-limited): https://ethereum-rpc.publicnode.com
L1_EXECUTION_RPC=

# ── L1 beacon (consensus) endpoint ────────────────────────────────────────────
# Robinhood posts DA as EIP-4844 blobs, which live on the beacon chain (not the
# execution layer).
#
# Standard beacon endpoints prune old blobs. The Compose stack supplies a local
# Blobscan-backed archive compatibility service as the default secondary. Nitro
# recomputes every blob commitment and matches its L1-derived versioned hash, so
# Blobscan cannot forge accepted DA. Keep a normal beacon endpoint here for the
# current tip, where it has better availability and lower latency:
#   curl -s "$L1_BEACON_URL/eth/v1/beacon/blobs/14229224" | head -c 120
# An empty old-slot response is expected; the archive fallback fills that gap.
L1_BEACON_URL=

# ── Optional: fallback beacon ─────────────────────────────────────────────────
# Nitro supports ONE fallback via --parent-chain.blob-client.secondary-beacon-url.
# Leave empty to use the local Blobscan archive adapter. Set only to a separately
# verified archive Beacon API if replacing the local adapter.
# (There is NO --parent-chain.blob-client.blob-storage-service-urls flag - an
# earlier revision of this runbook invented it; verified absent from the Nitro
# source 2026-07-21. Passing it makes the node fail to start.)
L1_BEACON_URL_FALLBACK=

# ── L2 transaction forwarding ─────────────────────────────────────────────────
# Nitro is a read/trace node, but eRPC may send eth_sendRawTransaction to it.
# Forward those writes to Robinhood's public sequencer gateway. This variable is
# required by Nitro Compose so endpoint migrations cannot silently retain an
# obsolete hard-coded default.
ROBINHOOD_TX_FORWARDING_TARGET=https://rpc.mainnet.chain.robinhood.com

# ── Node data directory (the L2 database) ─────────────────────────────────────
# Bind-mounted to /home/nitro/.arbitrum in the container. MUST be an ext4 path
# INSIDE the WSL2 distro (whose vhdx BRINGUP.md places on the D: NVMe) - NOT a
# /mnt/d/... Windows path (9p layer = catastrophically slow for the DB). The
# snapshot is extracted straight into this dir by restore-snapshot.sh.
# The container runs as uid 1000 (user `nitro`); restore-snapshot.sh chowns it.
NITRO_DATA_DIR=/home/clement/robinhood-nitro-data

# Empty, dedicated ext4 directory for the independently re-derived node. Never
# point this at NITRO_DATA_DIR and never restore a snapshot into it.
NITRO_GENESIS_DATA_DIR=/home/clement/robinhood-nitro-genesis-data
