# Keyless public dRPC only. Reserve CU still available; no automatic renewal.
# 40,000 CU/day bounds any 31-day month to 1.24M CU, including failures/polls.
ARC_DRPC_CU_ALLOWANCE=180000000
# Keyed Validation Cloud Arc mainnet URL (the path is the API key). Only the
# private gate reads it; it caps the lane at 1.5M CU/day (free team: 50M/month).
ARC_VALIDATIONCLOUD_URL=https://mainnet.arc.validationcloud.io/v1/<api-key>
