---
import Base from '../layouts/Base.astro'
import RobinhoodBanner from '../components/RobinhoodBanner.astro'
import Nav from '../components/Nav.astro'
import Hero from '../components/Hero.astro'
import SwapStory from '../components/SwapStory.astro'
import BuildOnOphis from '../components/BuildOnOphis.astro'
import NetworksSection from '../components/NetworksSection.astro'
import ChainsStrip from '../components/ChainsStrip.astro'
import HowSection from '../components/HowSection.astro'
import MarketsSection from '../components/MarketsSection.astro'
import ProtocolsSection from '../components/ProtocolsSection.astro'
import CodeSection from '../components/CodeSection.astro'
import FeatureGrid from '../components/FeatureGrid.astro'
import DevelopersSection from '../components/DevelopersSection.astro'
import SDKSection from '../components/SDKSection.astro'
import BuiltOnStrip from '../components/BuiltOnStrip.astro'
import FAQSection from '../components/FAQSection.astro'
import FinalCTA from '../components/FinalCTA.astro'
import Footer from '../components/Footer.astro'
---
<Base homeSchema>
  <RobinhoodBanner />
  <Nav />
  <main id="main" tabindex="-1">
    <Hero />
    <SwapStory />
    <BuildOnOphis />
    <NetworksSection />
    <ChainsStrip />
    <HowSection />
    <MarketsSection />
    <ProtocolsSection />
    <CodeSection />
    <FeatureGrid />
    <DevelopersSection />
    <SDKSection />
    <BuiltOnStrip />
    <FAQSection />
    <FinalCTA />
  </main>
  <Footer />
</Base>
