---
import { EVM_CHAINS, NEAR_DESTINATIONS } from '../data/chains'

const destinationLogos: Record<(typeof NEAR_DESTINATIONS)[number], string> = {
  Solana: '/logos/solana.svg',
  Bitcoin: '/logos/bitcoin.svg',
  Monad: '/logos/chain-monad.png',
  Hyperliquid: '/logos/chain-hyperliquid.svg',
  'X Layer': '/logos/chain-xlayer.png',
  Sui: '/logos/chain-sui.png',
  Tron: '/logos/chain-tron.svg',
}
const chains = [
  ...EVM_CHAINS.map((c) => ({ name: c.shortName, logo: c.logo })),
  ...NEAR_DESTINATIONS.map((name) => ({ name, logo: destinationLogos[name] })),
]
// Two passes feed a seamless CSS marquee: the first is the real, accessible set
// (counted by tests + read by AT); the second is an aria-hidden clone marked
// data-clone so the track can scroll exactly one set-width and loop with no seam.
// The inter-item gap is a per-item margin-right (not flex gap) so every item,
// including the last of each set, carries a trailing gap; translateX(-50%) then
// lands precisely on the clone's first item regardless of varying item widths.
const passes = [false, true]
---
<section class="chains">
  <div class="chains-inner reveal-up" data-reveal>
    <div class="label">Across networks</div>
    {/* WCAG 2.2.2 pause for auto-moving content. Intentionally invisible in
        normal use (no visual clutter); the control only appears when a keyboard
        user Tabs to it. CSS-only (checkbox + :has), so no JS and no CSP hash. */}
    <input type="checkbox" id="chains-pause" class="chains-pause-input" />
    <label for="chains-pause" class="chains-pause-btn">Pause animation</label>
    <div class="chains-marquee">
      <div class="chains-track">
        {passes.map((isClone) => chains.map((c) => (
          <div class="chain" aria-hidden={isClone ? 'true' : undefined} data-clone={isClone ? '' : undefined}>
            <img class="chain-logo" src={c.logo} alt="" width="20" height="20" loading="lazy" decoding="async" />
            <span class="chain-name">{c.name}</span>
          </div>
        )))}
      </div>
    </div>
  </div>
</section>

<style>
  .chains { padding: 60px 0; text-align: center; }
  .chains-inner { position: relative; }
  .label {
    text-transform: uppercase;
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--ophis-fg-faded);
    margin-bottom: 24px;
  }
  /* Auto-scrolling marquee. The track holds 2x the chains; every item carries a
     trailing margin-right, so the two sets are exactly equal width and
     translateX(-50%) loops with no seam. Edges fade via a mask. */
  .chains-marquee {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .chains-track {
    display: flex;
    align-items: center;
    width: max-content;
    animation: chains-scroll 46s linear infinite;
    will-change: transform;
  }
  /* Pause on hover, or via the keyboard-revealed control (WCAG 2.2.2). */
  .chains-marquee:hover .chains-track,
  .chains:has(.chains-pause-input:checked) .chains-track {
    animation-play-state: paused;
  }
  /* Keyboard-operable pause, hidden until focused (no visual clutter for mouse
     users; sighted keyboard users see it on Tab; SR users get the aria-label via
     the associated control). The checkbox is the focusable control; the label is
     the visible affordance that fades in on focus. */
  .chains-pause-input {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .chains-pause-btn {
    position: absolute;
    top: -2px;
    right: 24px;
    z-index: 2;
    padding: 3px 9px;
    font-size: 11px;
    color: var(--ophis-fg-muted);
    background: var(--ophis-surface);
    border: 1px solid var(--ophis-border);
    border-radius: 6px;
    cursor: pointer;
    /* invisible + inert until the control is keyboard-focused */
    opacity: 0;
    pointer-events: none;
    transition: opacity 120ms ease;
  }
  /* :focus (not :focus-visible); the control is only reachable by keyboard/AT
     (sr-only + pointer-events:none until shown), so any focus is a keyboard focus. */
  .chains-pause-input:focus + .chains-pause-btn {
    opacity: 1;
    pointer-events: auto;
    outline: 2px solid var(--ophis-saffron-60);
    outline-offset: 2px;
  }
  .chains:has(.chains-pause-input:checked) .chains-pause-btn { opacity: 1; pointer-events: auto; }
  @keyframes chains-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  .chain {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-right: 40px;
    color: var(--ophis-fg-muted);
    flex-shrink: 0;
  }
  .chain-logo {
    width: 20px;
    height: 20px;
    object-fit: contain;
    flex-shrink: 0;
  }
  .chain-name { font-weight: 600; font-size: 14px; line-height: 1.2; white-space: nowrap; }
  /* Reduced motion: no auto-scroll. Fall back to the original static wrapped row
     (all chains visible, no clones, no mask, no motion). */
  @media (prefers-reduced-motion: reduce) {
    .chains-marquee { overflow: visible; -webkit-mask-image: none; mask-image: none; }
    .chains-track {
      animation: none;
      width: auto;
      flex-wrap: wrap;
      justify-content: center;
      gap: 20px 32px;
      padding-inline: 24px;
    }
    /* The marquee uses per-item margin-right for a seamless loop; in the static
       wrapped fallback reset it to 0 and let the flex column-gap space items,
       so the wrapped rows have even, symmetric columns. */
    .chain { margin-right: 0; }
    .chain[data-clone] { display: none; }
    /* Nothing is animating, so the pause control is a pointless tab stop. */
    .chains-pause-input, .chains-pause-btn { display: none; }
  }
</style>
