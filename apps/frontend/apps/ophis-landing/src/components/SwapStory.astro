---
const steps = [
  { label: 'Intent', title: 'You set the terms.', text: 'Choose what to sell and receive. Ophis asks solvers for an executable quote. Review the estimated amount, fees, and minimum received before signing your intent.' },
  { label: 'Wallet', title: 'Your wallet stays in control.', text: 'Review the spending approval if one is needed, then sign your order. Your signature sets the limits a solver must respect.' },
  { label: 'Solvers', title: 'Routes compete for your order.', text: 'Solvers look for liquidity and matching orders, then compete to fulfil your intent. The auction selects a valid settlement proposal.' },
  { label: 'Settlement', title: 'Your limits are checked on-chain.', text: 'A solver submits the trade. The settlement contract verifies the signed order and its limits before exchanging the assets.' },
  { label: 'Received', title: 'The result returns to you.', text: 'Receive your tokens in your wallet. Follow the transaction in Explorer, check your order history, and see eligible activity in your rewards profile.' },
]
---
<section class="swap-story" id="swap-story" aria-label="How Ophis works" data-scene="0" data-reveal>
  <div class="story-toolbar">
    <p class="story-eyebrow">From intent to settlement</p>
    <button type="button" id="storyPause" class="story-pause" hidden aria-label="Pause workflow animation">Pause</button>
  </div>
  <div class="story-steps" role="group" aria-label="Workflow stages">
    {steps.map((step, index) => (
      <button type="button" data-story-step={index} aria-pressed={index === 0} aria-controls={`story-scene-${index}`}>
        <span class="story-number">0{index + 1}</span><span>{step.label}</span>
      </button>
    ))}
  </div>
  <div class="story-scenes">
    {steps.map((step, index) => (
      <article class="story-scene" id={`story-scene-${index}`} data-story-panel={index} hidden={index !== 0}>
        <div class="story-copy">
          <p class="story-eyebrow">0{index + 1} / 05</p>
          <h2>{step.title}</h2>
          <p>{step.text}</p>
        </div>
        <div class="story-visual" aria-hidden="true">
          {index === 0 && <div class="intent-visual">
            <div class="asset-card"><img src="/logos/usdc.png" alt="" width="44" height="44" /><div><small>You send</small><strong>10 USDC</strong></div></div>
            <div class="flow-track"><span class="flow-packet">→</span></div>
            <div class="asset-card"><img src="/logos/eth.png" alt="" width="44" height="44" /><div><small>Estimated receive</small><strong>0.004 ETH</strong></div></div>
            <div class="intent-limit"><span>Example rate</span><strong>1 ETH = 2,500 USDC</strong></div>
            <div class="intent-limit"><span>Minimum received <small>0.5% slippage</small></span><strong>0.00398 ETH</strong></div>
          </div>}
          {index === 1 && <div class="wallet-visual">
            <div class="visual-heading"><img src="/logos/workflow-wallet.svg" alt="" width="28" height="28" /><strong>Your wallet</strong><span class="status-dot"></span></div>
            <div class="wallet-row"><span>Spending approval</span><strong>10 USDC</strong></div>
            <div class="wallet-row"><span>Order limits</span><strong>Reviewed <span class="tick">✓</span></strong></div>
            <div class="signature"><img src="/logos/workflow-fingerprint.svg" alt="" width="48" height="48" /><span>Signed intent</span></div>
          </div>}
          {index === 2 && <div class="auction-visual">
            <div class="visual-heading"><img src="/ophis-mono.svg" alt="" width="28" height="28" /><strong>Ophis auction</strong><span class="status-dot"></span></div>
            <div class="solver-row"><span>01</span><div><strong>DEX liquidity</strong><i class="route-bar route-a"></i></div><span>→</span></div>
            <div class="solver-row"><span>02</span><div><strong>Matching orders</strong><i class="route-bar route-b"></i></div><span>→</span></div>
            <div class="solver-row winning-route"><span>03</span><div><strong>Winning proposal</strong><i class="route-bar route-c"></i></div><span class="tick">✓</span></div>
            <p class="visual-note">One intent. Competing solutions.</p>
          </div>}
          {index === 3 && <div class="settlement-visual">
            <div class="settlement-network"><img src="/logos/chain-ethereum.png" alt="" width="28" height="28" /><strong>On-chain settlement</strong></div>
            <div class="validation-row"><span class="tick">✓</span> Signature verified</div>
            <div class="validation-row"><span class="tick">✓</span> Signed limits respected</div>
            <div class="validation-row"><span class="tick">✓</span> Assets exchanged together</div>
            <div class="settlement-transfer"><img src="/logos/usdc.png" alt="" width="36" height="36" /><div class="flow-track"><span class="flow-packet">→</span></div><img src="/logos/eth.png" alt="" width="36" height="36" /></div>
          </div>}
          {index === 4 && <div class="receipt-visual">
            <div class="received-token"><img src="/logos/eth.png" alt="" width="64" height="64" /><span class="tick">✓</span></div>
            <small>Back in your wallet</small><strong>0.004 ETH received</strong>
            <div class="receipt-destinations"><span>Explorer</span><span>Order history</span><span>Rewards</span></div>
          </div>}
        </div>
      </article>
    ))}
  </div>
  <p class="story-caption">Illustrative amounts before fees: 10 ÷ 2,500 = 0.004 ETH, with a 0.00398 ETH minimum at 0.5% slippage. Live quotes reflect available liquidity, fees, and price impact.</p>
  <noscript><p>Choose assets and limits, approve spending if needed, sign your intent, let solvers compete, and receive tokens after on-chain settlement.</p></noscript>
</section>
<script>
  import '../lib/swap-story.ts'
</script>
<style>
  .swap-story { max-width: 1080px; margin: 48px auto 0; padding: 0 24px; }
  .story-toolbar { display: flex; justify-content: space-between; align-items: center; min-height: 44px; gap: 16px; }
  .story-eyebrow { color: var(--ophis-fg-muted); font-size: 11px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; margin: 0; }
  .story-pause { background: transparent; border: 0; color: var(--ophis-fg-muted); padding: 12px; min-height: 44px; cursor: pointer; font-size: 12px; }
  .story-steps { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12px; margin: 12px 0 0; }
  .story-steps button { position: relative; display: flex; align-items: center; gap: 10px; min-height: 56px; padding: 12px 0; border: 0; border-bottom: 1px solid var(--ophis-border); background: transparent; color: var(--ophis-fg-muted); cursor: pointer; font-size: 13px; }
  .story-number { font: italic 20px Georgia, serif; }
  .story-steps button[aria-pressed="true"] { color: var(--ophis-fg); border-color: var(--ophis-fg); }
  .story-steps button::after { content: ''; position: absolute; bottom: -1px; left: 0; width: 100%; height: 2px; background: var(--ophis-fg); transform: scaleX(0); transform-origin: left; }
  .story-scene { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; gap: 64px; min-height: 400px; padding: 40px 0; }
  .story-scene[hidden], .story-pause[hidden] { display: none; }
  .story-copy h2 { font: 400 clamp(30px, 3vw, 42px)/1.12 Georgia, serif; letter-spacing: -.03em; margin: 16px 0; max-width: 420px; }
  .story-copy > p:last-child { font-size: 15px; line-height: 1.7; color: var(--ophis-fg-muted); margin: 0; max-width: 420px; }
  .story-visual { min-height: 300px; display: grid; align-items: center; background: var(--ophis-surface); border: 1px solid var(--ophis-border); border-radius: 20px; padding: 28px; min-width: 0; }
  .story-visual small { display: block; color: var(--ophis-fg-muted); font-size: 12px; margin-bottom: 6px; }
  .story-visual strong { font-weight: 500; }
  .asset-card { display: flex; align-items: center; gap: 16px; background: var(--ophis-bg); padding: 16px; border-radius: 12px; }
  .asset-card strong { font-size: 24px; }
  .asset-card img { object-fit: contain; }
  .intent-visual > .flow-track { height: 1px; width: 26px; margin: 13px auto; transform: rotate(90deg); }
  .intent-limit, .wallet-row { display: flex; justify-content: space-between; gap: 12px; font-size: 13px; padding: 16px 0; }
  .intent-limit { padding-bottom: 0; color: var(--ophis-fg-muted); }
  .visual-heading, .settlement-network { display: flex; align-items: center; gap: 10px; padding-bottom: 20px; font-size: 15px; }
  .status-dot { width: 6px; height: 6px; background: #1c6b3f; border-radius: 50%; margin-left: auto; }
  .wallet-row { border-top: 1px solid var(--ophis-border); }
  .wallet-row > span { color: var(--ophis-fg-muted); }
  .signature { display: flex; flex-direction: column; align-items: center; padding: 12px; border: 1px solid #e8c4a8; border-radius: 12px; background: var(--ophis-peach); color: var(--ophis-brown); font-size: 12px; }
  .signature img { margin-bottom: 8px; }
  .solver-row { display: flex; align-items: center; gap: 14px; padding: 14px; border-radius: 10px; font-size: 12px; margin-bottom: 6px; }
  .solver-row > div { flex: 1; }
  .solver-row > span:first-child { color: var(--ophis-fg-muted); font: italic 16px Georgia, serif; }
  .route-bar { display: block; margin-top: 10px; height: 3px; background: currentColor; transform-origin: left; opacity: .35; }
  .route-a { width: 70%; }.route-b { width: 84%; }.route-c { width: 100%; }
  .winning-route { background: var(--ophis-peach); color: var(--ophis-brown); }
  .visual-note { font-size: 12px; color: var(--ophis-fg-muted); text-align: center; margin: 18px 0 0; }
  .validation-row { display: flex; align-items: center; gap: 12px; padding: 12px 0; font-size: 13px; border-top: 1px solid var(--ophis-border); }
  .tick { color: #1c6b3f; }
  .settlement-transfer { display: flex; align-items: center; gap: 16px; margin-top: 20px; }
  .flow-track { position: relative; background: var(--ophis-border); height: 1px; flex: 1; }
  .flow-packet { position: absolute; top: -12px; left: 0; background: var(--ophis-surface); padding: 0 6px; }
  .receipt-visual { text-align: center; }
  .receipt-visual > strong { display: block; font: 32px Georgia, serif; margin: 12px 0 28px; }
  .received-token { position: relative; width: 80px; height: 80px; margin: 0 auto 20px; display: grid; place-items: center; background: white; border-radius: 50%; }
  .received-token > .tick { position: absolute; right: -4px; bottom: 0; width: 26px; height: 26px; display: grid; place-items: center; background: #e9f4ee; border: 2px solid var(--ophis-surface); border-radius: 50%; }
  .receipt-destinations { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; color: var(--ophis-fg-muted); font-size: 11px; }
  .receipt-destinations span + span::before { content: '·'; margin-right: 8px; }
  .story-caption { border-top: 1px solid var(--ophis-border); padding-top: 16px; font-size: 12px; color: var(--ophis-fg-muted); margin: 0; }
  @media (prefers-reduced-motion: no-preference) {
    [data-playing] .story-steps button[aria-pressed="true"]::after { animation: stage-progress 4.5s linear both; }
    [data-playing] .story-copy, [data-playing] .story-visual { animation: arrive .55s ease both; }
    [data-playing] .flow-packet { animation: packet 2s ease-in-out infinite; }
    [data-playing] .signature img { animation: arrive 1.2s .4s both; }
    [data-playing] .route-bar { animation: stage-progress 1.5s .3s both; }
    [data-playing] .route-b { animation-delay: .6s; } [data-playing] .route-c { animation-delay: .9s; }
    [data-playing] .winning-route { animation: arrive .6s 1.4s both; }
    [data-playing] .validation-row { animation: arrive .45s .3s both; }
    [data-playing] .validation-row:nth-child(3) { animation-delay: .7s; } [data-playing] .validation-row:nth-child(4) { animation-delay: 1.1s; }
    [data-playing] .received-token { animation: arrive .8s both; }
    @keyframes arrive { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
    @keyframes packet { from { left: 0; opacity: 0; } 20%, 80% { opacity: 1; } to { left: calc(100% - 24px); opacity: 0; } }
    @keyframes stage-progress { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  }
  @media (max-width: 720px) {
    .swap-story { padding: 0 16px; }
    .story-steps { gap: 6px; }
    .story-steps button { flex-direction: column; gap: 6px; font-size: 10px; }
    .story-scene { grid-template-columns: minmax(0, 1fr); gap: 24px; padding: 28px 0; min-height: 520px; align-content: start; }
    .story-copy { min-height: 162px; }
    .story-copy h2 { font-size: 30px; margin: 10px 0; }
    .story-copy > p:last-child { font-size: 13px; }
    .story-visual { min-height: 300px; padding: 20px; }
    .story-eyebrow { font-size: 10px; }
  }
</style>
