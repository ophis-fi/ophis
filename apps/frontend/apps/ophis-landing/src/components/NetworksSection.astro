---
/* The three kinds of swap, one panel each: an order on an EVM chain, a native
   Solana swap, and a deposit swap to or from Bitcoin and the other networks.
   Every panel is in the markup; the inline module only shows one at a time. */
import { EVM_CHAIN_COUNT } from '../data/chains'

const panels = [
  {
    id: 'ethereum',
    chip: 'EVM chains',
    icon: '/logos/chain-ethereum.png',
    title: `Ethereum and ${EVM_CHAIN_COUNT - 1} more EVM chains`,
    text: 'Pick two tokens on the same chain and sign one order. Solvers compete to fill it with MEV protection, and the tokens you buy arrive in your wallet.',
    tokens: [
      { label: 'ETH', icon: '/logos/eth.png' },
      { label: 'USDC', icon: '/logos/usdc.png' },
    ],
  },
  {
    id: 'solana',
    chip: 'Solana',
    icon: '/logos/solana.svg',
    title: 'Solana, with your Solana wallet',
    text: 'Swap SOL and Solana tokens without leaving the network. Your order settles on Solana through the Ophis program, routed across venues such as Raydium, Orca and Meteora.',
    tokens: [
      { label: 'SOL', icon: '/logos/solana.svg' },
      { label: 'USDC', icon: '/logos/usdc.png' },
    ],
  },
  {
    id: 'bitcoin',
    chip: 'Bitcoin',
    icon: '/logos/bitcoin.svg',
    title: 'Bitcoin and other networks, by deposit',
    text: 'Trade to or from native BTC. You get a quote and a one-time deposit address, send the funds from your own wallet, and receive the other asset. A refund address covers a swap that cannot complete. The same flow reaches networks such as Sui, Tron and Zcash.',
    tokens: [{ label: 'BTC', icon: '/logos/bitcoin.svg' }],
  },
]
---
<section class="product" id="product" aria-labelledby="productTitle">
  <hr class="rule" />
  <div class="sec-head">
    <p class="eyebrow reveal-up" data-reveal>Product</p>
    <h2 class="serif reveal-up" id="productTitle" data-reveal>One place. <em>Your next swap.</em></h2>
    <p class="lede reveal-up" data-reveal>Swap on EVM chains, on Solana, and to or from Bitcoin, all from the same swap box.</p>
  </div>
  <div class="chips reveal-up" role="group" aria-label="Kinds of swap" data-reveal>
    {panels.map((panel, index) => (
      <button type="button" data-chain={panel.id} aria-pressed={index === 0 ? 'true' : 'false'}><img src={panel.icon} alt="" width="20" height="20" />{panel.chip}</button>
    ))}
  </div>
  <div class="panels reveal-up" data-reveal>
    {panels.map((panel, index) => (
      <div class="chain-panel" data-panel={panel.id} hidden={index !== 0}>
        <h3>{panel.title}</h3>
        <p>{panel.text}</p>
        <div class="chain-tokens">
          {panel.tokens.map((token) => (
            <span><img src={token.icon} alt="" width="22" height="22" />{token.label}</span>
          ))}
        </div>
        <a class="chain-all" href="/supported-chains/">See all supported chains <span aria-hidden="true">→</span></a>
      </div>
    ))}
  </div>
</section>
<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('[data-chain]')
  const panels = document.querySelectorAll<HTMLElement>('[data-panel]')
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)')
  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      chips.forEach((other) => other.setAttribute('aria-pressed', String(other === chip)))
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.panel !== chip.dataset.chain
        if (!panel.hidden && !reduced.matches && panel.animate) {
          panel.animate(
            [{ opacity: 0.35, transform: 'translateY(6px)' }, { opacity: 1, transform: 'translateY(0)' }],
            { duration: 260, easing: 'cubic-bezier(.22,1,.36,1)' },
          )
        }
      })
    })
  })
</script>

<style>
  .product { max-width: 1200px; margin: 0 auto; padding: 64px 24px 8px; }
  .rule { height: 1px; background: var(--ophis-border); border: 0; margin: 0 0 40px; }
  .sec-head { max-width: 640px; margin-bottom: 32px; }
  .sec-head .eyebrow { margin: 0 0 12px; }
  h2 { font-size: clamp(34px, 4vw, 44px); margin: 0; }
  .sec-head .lede { margin: 12px 0 0; }
  .chips { display: flex; gap: 8px; flex-wrap: wrap; margin: 0 0 20px; }
  .chips button { border: 1px solid var(--ophis-border); background: var(--ophis-bg); border-radius: 9999px; min-height: 48px; padding: 0 18px; font-size: 14px; font-weight: 500; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; color: var(--ophis-fg); }
  .chips button img { width: 20px; height: 20px; border-radius: 50%; object-fit: contain; display: block; }
  .chips button[aria-pressed="true"] { background: var(--ophis-fg); border-color: var(--ophis-fg); color: #fff; }
  .chain-panel { background: var(--ophis-bg); border: 1px solid var(--ophis-border); border-radius: 20px; padding: 24px; display: grid; gap: 8px; }
  /* display: grid above would otherwise show a panel marked hidden. */
  .chain-panel[hidden] { display: none; }
  .chain-panel h3 { margin: 0; font-size: 18px; font-weight: 500; letter-spacing: -0.01em; }
  .chain-panel p { margin: 0; font-size: 15px; color: var(--ophis-fg-muted); max-width: 62ch; }
  .chain-tokens { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 8px; }
  .chain-tokens span { display: inline-flex; align-items: center; gap: 8px; background: var(--ophis-surface); border-radius: 9999px; padding: 8px 14px 8px 8px; font-size: 14px; font-weight: 500; }
  .chain-tokens img { width: 22px; height: 22px; border-radius: 50%; object-fit: contain; display: block; }
  .chain-all { font-size: 14px; font-weight: 500; color: var(--ophis-fg); text-decoration: none; margin-top: 8px; width: fit-content; }
  .chain-all:hover { text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 640px) {
    .product { padding: 48px 16px 8px; }
  }
</style>
