---
// Aggregator listings alone do not confirm executable quotes.
type Protocol = { name: string; logo: string; status?: string }

const protocols: Protocol[] = [
  { name: 'Uniswap',     logo: '/logos/protocols/uniswap-v2.svg' },
  { name: 'Curve',       logo: '/logos/protocols/curve.png' },
  { name: 'Balancer',    logo: '/logos/protocols/balancer.svg' },
  { name: 'PancakeSwap', logo: '/logos/protocols/pancakeswap-v2.svg' },
  { name: 'SushiSwap',   logo: '/logos/protocols/sushi-v2.svg' },
  { name: 'Velodrome',   logo: '/logos/protocols/velodrome.svg' },
  { name: 'Aerodrome',   logo: '/logos/protocols/aerodrome.png' },
  { name: 'QuickSwap',   logo: '/logos/protocols/quickswap.png' },
  { name: 'Fluid',       logo: '/logos/protocols/fluid.svg' },
  { name: 'DODO',        logo: '/logos/protocols/dodo.png' },
  { name: 'LFJ',         logo: '/logos/protocols/lfj.png' },
  { name: 'KyberSwap',   logo: '/logos/protocols/kyberswap.svg' },
  { name: 'Ekubo',       logo: '/logos/protocols/ekubo.svg' },
  { name: 'OKX',         logo: '/logos/protocols/okx.svg' },
  { name: 'RamsesX',     logo: '/logos/protocols/ramses.svg', status: 'Routing unverified' },
  { name: '1inch',       logo: '/logos/protocols/1inch.svg' },
  { name: 'Dexalot',     logo: '/logos/protocols/dexalot.png', status: 'Routing unverified' },
  { name: 'Native',      logo: '/logos/protocols/native.png', status: 'Routing unverified' },
  { name: 'Pharaoh',     logo: '/logos/protocols/pharaoh.svg', status: 'Routing unverified' },
  { name: 'Arcus',       logo: '/logos/protocols/arcus.svg', status: 'Integration pending' },
]
---
<section class="protocols">
  <div class="protocols-inner">
    <div class="label reveal-up" data-reveal>Aggregated liquidity</div>
    <h2 class="serif reveal-up" data-reveal>
      Every venue. <em>Every chain.</em>
    </h2>
    <p class="sub reveal-up" data-reveal>
      Ophis is solver-driven. A competitive network of solvers races to fill your intent,
      routing across the deepest on-chain AMMs and professional DEX aggregators on every
      network we settle. You sign once; they find the best executable price, MEV-protected.
    </p>

    <div class="protocol-wall reveal-up" data-reveal>
      <div class="protocol-grid stagger">
        {protocols.map(p => (
          <div class="protocol reveal-up" data-reveal>
            <span class="protocol-badge">
              <img src={p.logo} alt={`${p.name} logo`} width="30" height="30" loading="lazy" decoding="async" />
            </span>
            <span class="protocol-name">{p.name}</span>
            {p.status && <span class="protocol-status">{p.status}</span>}
          </div>
        ))}
      </div>
    </div>

    <p class="solver-note reveal-up" data-reveal>
      Solvers select from the venues available for your chain and token pair.
      Venues marked unverified or pending are not confirmed routing sources.
    </p>

  </div>
</section>

<style>
  .protocols { padding: 80px 56px; text-align: center; }
  .protocols-inner { max-width: 1100px; margin: 0 auto; }
  .label {
    display: inline-block;
    text-transform: uppercase;
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--ophis-fg-faded);
    margin-bottom: 16px;
  }
  h2 {
    font-size: 32px;
    margin: 0 0 12px;
  }
  .sub {
    color: var(--ophis-fg-muted);
    margin: 0 auto 44px;
    max-width: 660px;
    font-size: 15px;
    line-height: 1.6;
  }
  .protocol-wall { position: relative; }
  .protocol-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
    border-radius: var(--ophis-radius);
  }
  .protocol {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding: 18px 8px;
    background: var(--ophis-surface);
    border: 1px solid var(--ophis-border);
    border-radius: var(--ophis-radius);
    transition: border-color 200ms ease;
  }
  .protocol:hover {
    border-color: var(--ophis-fg-muted);
  }
  /* Light chip: third-party brand marks are authored for light backgrounds,
     so monochrome-dark logos (Uniswap, Sushi, PancakeSwap, Balancer) would
     vanish on a dark badge. A near-white circle keeps every logo legible. */
  .protocol-badge {
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #f4f4f6;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.06);
    flex-shrink: 0;
  }
  .protocol-badge img {
    width: 30px;
    height: 30px;
    object-fit: contain;
  }
  .protocol-name {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--ophis-fg-muted);
    line-height: 1.2;
  }
  .protocol-status {
    font-size: 11px;
    color: var(--ophis-fg-muted);
    line-height: 1.4;
  }
  .solver-note {
    margin: 32px auto 0;
    max-width: 620px;
    font-size: 13.5px;
    color: var(--ophis-fg-muted);
    line-height: 1.6;
  }

  @media (max-width: 900px) {
    .protocol-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  @media (max-width: 560px) {
    .protocols { padding: 64px 24px; }
    .protocol-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    h2 { font-size: 26px; }
  }
</style>
