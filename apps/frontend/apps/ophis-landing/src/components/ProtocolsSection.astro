---
const protocols = [
  { name: 'Uniswap',     logo: '/logos/protocols/uniswap-v2.svg' },
  { name: 'Curve',       logo: '/logos/protocols/curve.png' },
  { name: 'Balancer',    logo: '/logos/protocols/balancer.svg' },
  { name: 'PancakeSwap', logo: '/logos/protocols/pancakeswap-v2.svg' },
  { name: 'SushiSwap',   logo: '/logos/protocols/sushi-v2.svg' },
  { name: 'Velodrome',   logo: '/logos/protocols/velodrome.svg' },
  { name: 'Aerodrome',   logo: '/logos/protocols/aerodrome.png' },
  { name: 'QuickSwap',   logo: '/logos/protocols/quickswap.png' },
  { name: 'Fluid',       logo: '/logos/protocols/fluid.svg' },
  { name: 'DODO',        logo: '/logos/protocols/dodo.png' },
  { name: 'LFJ',         logo: '/logos/protocols/lfj.png' },
  { name: 'KyberSwap',   logo: '/logos/protocols/kyberswap.svg' },
  { name: 'UP33',        logo: '/logos/protocols/up33.svg' },
  { name: 'Ekubo',       logo: '/logos/protocols/ekubo.svg' },
  { name: 'OKX',         logo: '/logos/protocols/okx.svg' },
  { name: 'RamsesX',     logo: '/logos/protocols/ramses.svg' },
  { name: '1inch',       logo: '/logos/protocols/1inch.svg' },
  { name: 'Dexalot',     logo: '/logos/protocols/dexalot.png' },
  { name: 'Native',      logo: '/logos/protocols/native.png' },
  { name: 'Pharaoh',     logo: '/logos/protocols/pharaoh.svg' },
  // Solana: Raydium, Orca Whirlpools, Meteora DLMM, PumpSwap and Manifest are priced
  // directly by the native solver; Jupiter is used as a router. `fill` marks a logo that
  // comes as a full square and is shown as a disc.
  { name: 'Raydium',     logo: '/logos/protocols/raydium.png', fill: true },
  { name: 'Orca',        logo: '/logos/protocols/orca.png', fill: true },
  { name: 'Meteora',     logo: '/logos/protocols/meteora.png', fill: true },
  { name: 'PumpSwap',    logo: '/logos/protocols/pumpswap.png' },
  { name: 'Manifest',    logo: '/logos/protocols/manifest.svg' },
  { name: 'Jupiter',     logo: '/logos/protocols/jupiter.png', fill: true },
]
---
<section class="protocols">
  <div class="protocols-inner">
    <div class="label reveal-up" data-reveal>Aggregated liquidity</div>
    <h2 class="serif reveal-up" data-reveal>
      Many venues. <em>One signed order.</em>
    </h2>
    <p class="sub reveal-up" data-reveal>
      Ophis is solver-driven. Solvers compare configured AMMs and DEX aggregators
      for your chain and token pair. You sign a bounded order; the available
      routes and executable price depend on current liquidity.
    </p>

    <div class="protocol-wall reveal-up" data-reveal>
      <div class="protocol-grid stagger">
        {protocols.map(p => (
          <div class="protocol reveal-up" data-reveal>
            <span class="protocol-badge">
              <img class:list={[{ fill: p.fill }]} src={p.logo} alt={`${p.name} logo`} width="30" height="30" loading="lazy" decoding="async" />
            </span>
            <span class="protocol-name">{p.name}</span>
          </div>
        ))}
      </div>
    </div>

    <p class="solver-note reveal-up" data-reveal>
      Solvers select from the venues available for your chain and token pair.
    </p>

  </div>
</section>

<style>
  .protocols { padding: 80px 56px; text-align: center; }
  .protocols-inner { max-width: 1100px; margin: 0 auto; }
  .label {
    display: inline-block;
    text-transform: uppercase;
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--ophis-fg-faded);
    margin-bottom: 16px;
  }
  h2 {
    font-size: 32px;
    margin: 0 0 12px;
  }
  .sub {
    color: var(--ophis-fg-muted);
    margin: 0 auto 44px;
    max-width: 660px;
    font-size: 15px;
    line-height: 1.6;
  }
  .protocol-wall { position: relative; }
  .protocol-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
    border-radius: var(--ophis-radius);
  }
  .protocol {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding: 18px 8px;
    background: var(--ophis-surface);
    border: 1px solid var(--ophis-border);
    border-radius: var(--ophis-radius);
    transition: border-color 200ms ease;
  }
  .protocol:hover {
    border-color: var(--ophis-fg-muted);
  }
  /* Light chip: third-party brand marks are authored for light backgrounds,
     so monochrome-dark logos (Uniswap, Sushi, PancakeSwap, Balancer) would
     vanish on a dark badge. A near-white circle keeps every logo legible. */
  .protocol-badge {
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #f4f4f6;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.06);
    flex-shrink: 0;
    overflow: hidden;
  }
  .protocol-badge img {
    width: 30px;
    height: 30px;
    object-fit: contain;
  }
  .protocol-badge img.fill {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .protocol-name {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--ophis-fg-muted);
    line-height: 1.2;
  }
  .solver-note {
    margin: 32px auto 0;
    max-width: 620px;
    font-size: 13.5px;
    color: var(--ophis-fg-muted);
    line-height: 1.6;
  }

  @media (max-width: 900px) {
    .protocol-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  /* Phones: 26 tall tiles ran to two screens of logos. Each venue becomes a pill
     (logo and name on one line) and the pills wrap, about a third of the height. */
  @media (max-width: 560px) {
    .protocols { padding: 64px 24px; }
    .protocol-grid { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
    .protocol { flex-direction: row; gap: 8px; padding: 5px 12px 5px 5px; border-radius: 9999px; }
    .protocol-badge { width: 28px; height: 28px; }
    .protocol-badge img { width: 18px; height: 18px; }
    .protocol-name { white-space: nowrap; }
    h2 { font-size: 26px; }
  }
</style>
