---
const markets = [
  {
    href: '/stablecoin-swaps/',
    eyebrow: 'Stablecoins',
    title: 'Route stablecoin swaps',
    copy: 'Compare supported stablecoin routes on Base, Avalanche, Ink, Robinhood Chain, and the rest of the Ophis network.',
  },
  {
    href: '/tokenized-stocks-rwa/',
    eyebrow: 'Tokenized assets',
    title: 'Trade new onchain markets',
    copy: 'Explore Robinhood Chain Stock Tokens, Coinbase Tokenized Stocks on Base, and supported real-world assets.',
  },
  {
    href: '/swap/robinhood-chain/',
    eyebrow: 'Robinhood Chain',
    title: 'Open the live market',
    copy: 'Use canonical-asset checks, corporate-action context, and MEV-protected batch settlement before signing.',
  },
  {
    href: '/ai-agent-crypto-swap-api/',
    eyebrow: 'Agents and builders',
    title: 'Integrate without an API key',
    copy: 'Connect through the hosted MCP server, the public Intent API, or the dependency-free Ophis SDK.',
  },
]
---

<section class="markets" id="markets">
  <div class="markets-inner">
    <div class="label reveal-up" data-reveal>Markets and integrations</div>
    <h2 class="reveal-up section-bloom" data-reveal>Built for assets that <span class="accent">move.</span></h2>
    <div class="market-grid stagger">
      {markets.map((market) => (
        <a class="market-card reveal-up" data-reveal href={market.href}>
          <span class="eyebrow">{market.eyebrow}</span>
          <strong>{market.title}</strong>
          <span class="copy">{market.copy}</span>
          <span class="arrow" aria-hidden="true">Explore →</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .markets { padding: 80px 56px; }
  .markets-inner { max-width: 1080px; margin: 0 auto; }
  .label {
    color: var(--ophis-saffron-60);
    font: 12px/1.2 'Geist Mono', ui-monospace, monospace;
    letter-spacing: 0.18em;
    text-align: center;
    text-transform: uppercase;
  }
  h2 {
    font-size: 42px;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 14px 0 40px;
    text-align: center;
  }
  .market-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .market-card {
    background: var(--ophis-surface);
    border: 1px solid var(--ophis-border);
    border-radius: var(--ophis-radius);
    color: var(--ophis-fg);
    display: flex;
    flex-direction: column;
    min-height: 190px;
    padding: 26px;
    text-decoration: none;
    transition: border-color 150ms ease, transform 150ms ease;
  }
  .market-card:hover { border-color: rgba(242, 166, 62, 0.5); transform: translateY(-2px); }
  .market-card:focus-visible { outline: 2px solid var(--ophis-saffron-60); outline-offset: 3px; }
  .eyebrow { color: var(--ophis-saffron-60); font-size: 12px; margin-bottom: 14px; text-transform: uppercase; }
  strong { font-size: 21px; font-weight: 600; margin-bottom: 8px; }
  .copy { color: var(--ophis-fg-muted); font-size: 14px; line-height: 1.55; }
  .arrow { color: var(--ophis-fg); font-size: 13px; margin-top: auto; padding-top: 20px; }
  @media (max-width: 720px) {
    .markets { padding: 60px 20px; }
    h2 { font-size: 34px; }
    .market-grid { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) { .market-card { transition: none; } }
</style>
