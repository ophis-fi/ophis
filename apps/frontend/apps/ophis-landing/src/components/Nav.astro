---
const links = [
  { href: '/#markets', label: 'Markets' },
  { href: 'https://docs.ophis.fi', label: 'Docs' },
  { href: 'https://github.com/ophis-fi/ophis/tree/main/packages/sdk', label: 'SDK' },
  { href: '/ai-agent-crypto-swap-api/', label: 'Integrate' },
  { href: '/learn/', label: 'Learn' },
  { href: '/blog/', label: 'Blog' },
  { href: 'https://github.com/ophis-fi/ophis/blob/main/CHANGELOG.md', label: 'Changelog' },
]
---
<nav class="nav">
  <div class="nav-inner">
    <a class="logo" href="/">
      <img class="logo-mark" src="/ophis-mono.svg" alt="" width="24" height="24" />
      <span class="logo-word">Ophis</span>
    </a>
    <div class="nav-links">
      {links.map(({ href, label }) => (
        <a href={href} rel={href.startsWith('http') ? 'noopener' : undefined}>{label}</a>
      ))}
    </div>
    <a class="nav-cta" href="https://swap.ophis.fi/#/swap">Trade</a>
    <button
      type="button"
      class="nav-burger"
      id="nav-burger"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="nav-drawer"
    >
      <span class="nav-burger-box" aria-hidden="true"><span class="nav-burger-bar"></span></span>
    </button>
  </div>
</nav>
<!-- Drawer + scrim live OUTSIDE <nav> on purpose: .nav sets backdrop-filter,
     which establishes a containing block for position:fixed descendants. If the
     drawer were nested inside .nav it would anchor to the nav box instead of the
     viewport (the bug fixed in PR #333). As siblings of <nav> they anchor to the
     viewport correctly. -->
<div class="nav-drawer" id="nav-drawer" data-open="false" aria-hidden="true">
  <button
    type="button"
    class="nav-drawer-close"
    id="nav-drawer-close"
    aria-label="Close navigation menu"
    tabindex="-1"
  >
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
      <path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
    </svg>
  </button>
  <nav class="nav-drawer-links" aria-label="Mobile">
    {links.map(({ href, label }) => (
      <a href={href} rel={href.startsWith('http') ? 'noopener' : undefined} tabindex="-1">{label}</a>
    ))}
    <a class="nav-drawer-cta" href="https://swap.ophis.fi/#/swap" tabindex="-1">Trade</a>
  </nav>
</div>
<div class="nav-scrim" id="nav-scrim" data-open="false" aria-hidden="true"></div>
<script>
  import '../lib/nav-blur.ts'
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    padding-block: 16px;
  }
  .nav-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding-inline: 56px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .nav .logo {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-weight: 500;
    font-size: 16px;
    letter-spacing: -0.01em;
    color: var(--ophis-fg);
    text-decoration: none;
  }
  .logo-mark {
    width: 24px;
    height: 24px;
    object-fit: contain;
    display: block;
    flex-shrink: 0;
  }
  .logo-word {
    color: var(--ophis-fg);
  }
  .nav-links { display: flex; gap: 24px; }
  .nav-links a {
    color: var(--ophis-fg-muted);
    font-size: 13px;
    text-decoration: none;
    transition: color 120ms ease;
  }
  .nav-links a:hover { color: var(--ophis-fg); }
  .nav-cta {
    background: var(--ophis-saffron-60);
    color: #fff;
    padding: 10px 18px;
    border-radius: 9999px;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
  }
  /* --- Mobile nav (hamburger + slide-in drawer) --- */
  .nav-burger {
    display: none;
    appearance: none;
    background: transparent;
    border: 1px solid var(--ophis-border);
    border-radius: var(--ophis-radius-sm);
    width: 40px;
    height: 40px;
    padding: 0;
    cursor: pointer;
    color: var(--ophis-fg);
    align-items: center;
    justify-content: center;
  }
  .nav-burger:focus-visible {
    outline: 2px solid var(--ophis-saffron-60);
    outline-offset: 2px;
  }
  .nav-burger-box { position: relative; display: block; width: 18px; height: 12px; }
  .nav-burger-bar,
  .nav-burger-bar::before,
  .nav-burger-bar::after {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    transition: transform 200ms ease, opacity 150ms ease;
  }
  .nav-burger-bar { top: 5px; }
  .nav-burger-bar::before { content: ''; top: -5px; }
  .nav-burger-bar::after  { content: ''; top: 5px; }

  /* Scrim sits ABOVE the sticky nav (z-50) so the open drawer is a true modal:
     the whole header (logo included) is covered and non-interactive. The drawer
     carries its own close button, so the now-covered burger is not the close
     affordance. */
  .nav-scrim {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: rgba(0, 0, 0, 0.55);
    opacity: 0;
    visibility: hidden;
    transition: opacity 200ms ease, visibility 0s linear 200ms;
  }
  .nav-scrim[data-open='true'] {
    opacity: 1;
    visibility: visible;
    transition: opacity 200ms ease;
  }

  .nav-drawer {
    position: fixed;
    top: 0;
    right: 0;
    z-index: 61;
    height: 100dvh;
    width: min(82vw, 320px);
    padding: 88px 24px 32px;
    background: var(--ophis-bg);
    border-left: 1px solid var(--ophis-border);
    transform: translateX(100%);
    visibility: hidden;
    transition: transform 240ms cubic-bezier(0.22, 1, 0.36, 1), visibility 0s linear 240ms;
  }
  .nav-drawer[data-open='true'] {
    transform: translateX(0);
    visibility: visible;
    transition: transform 240ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .nav-drawer-links { display: flex; flex-direction: column; gap: 4px; }
  .nav-drawer-links a {
    color: var(--ophis-fg-muted);
    font-size: 16px;
    text-decoration: none;
    padding: 12px 8px;
    border-radius: var(--ophis-radius-sm);
    transition: color 120ms ease, background-color 120ms ease;
  }
  .nav-drawer-links a:hover { color: var(--ophis-fg); background: var(--ophis-surface); }
  .nav-drawer-links a:focus-visible { outline: 2px solid var(--ophis-saffron-60); outline-offset: 2px; }
  .nav-drawer-cta {
    margin-top: 12px;
    background: var(--ophis-saffron-60);
    color: #fff !important;
    font-weight: 500;
    text-align: center;
    border-radius: 9999px;
  }
  .nav-drawer-close {
    position: absolute;
    top: 22px;
    right: 20px;
    width: 36px;
    height: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    appearance: none;
    background: transparent;
    border: 1px solid var(--ophis-border);
    border-radius: var(--ophis-radius-sm);
    color: var(--ophis-fg);
    cursor: pointer;
  }
  .nav-drawer-close:focus-visible {
    outline: 2px solid var(--ophis-saffron-60);
    outline-offset: 2px;
  }

  @media (max-width: 720px) {
    .nav-inner { padding-inline: 20px; }
    .nav-links { display: none; }
    .nav-burger { display: inline-flex; }
    .nav .nav-cta { display: none; }
  }
  @media (min-width: 721px) {
    /* never show the drawer/scrim on desktop even if a stale data-open lingers */
    .nav-drawer, .nav-scrim { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-drawer, .nav-scrim,
    .nav-burger-bar, .nav-burger-bar::before, .nav-burger-bar::after { transition: none !important; }
  }
</style>
