---
export interface Props {
  /** Heading: plain start, italic end. */
  lead?: string
  emphasis?: string
  text?: string
  primary?: { href: string; label: string }
  secondary?: { href: string; label: string }
}
const {
  lead = 'Your next move.',
  emphasis = 'On your terms.',
  text = 'Choose your assets. Check your limits. Take it from there.',
  primary = { href: 'https://swap.ophis.fi/#/swap', label: 'Swap now' },
  secondary = { href: 'https://docs.ophis.fi', label: 'Read the docs' },
} = Astro.props
---
<section class="final" aria-labelledby="ctaTitle">
  <div class="final-inner reveal-up" data-reveal>
    <h2 class="serif" id="ctaTitle">{lead} <em>{emphasis}</em></h2>
    <p>{text}</p>
    <div class="ctas">
      <a class="cta-primary" href={primary.href}>{primary.label}</a>
      <a class="cta-secondary" href={secondary.href}>{secondary.label}</a>
    </div>
  </div>
</section>

<style>
  .final {
    max-width: 1200px;
    margin: 64px auto 0;
    padding: 0 24px 64px;
  }
  .final-inner {
    background: var(--ophis-fg);
    color: #fff;
    border-radius: 20px;
    padding: 56px 32px;
    text-align: center;
  }
  h2 {
    font-size: clamp(34px, 4vw, 44px);
    margin: 0;
  }
  p {
    color: #c9ccd1;
    margin: 12px auto 0;
    max-width: 52ch;
    font-size: 16px;
  }
  .ctas {
    display: flex;
    gap: 12px;
    justify-content: center;
    margin-top: 28px;
    flex-wrap: wrap;
  }
  .cta-primary, .cta-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    min-height: 48px;
    padding: 12px 22px;
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
  }
  .cta-primary { background: #fff; color: var(--ophis-fg); }
  .cta-secondary { border: 1px solid rgba(255, 255, 255, 0.4); color: #fff; }
  @media (max-width: 640px) {
    .final { padding: 0 16px 48px; }
    .final-inner { padding: 40px 20px; }
  }
</style>
