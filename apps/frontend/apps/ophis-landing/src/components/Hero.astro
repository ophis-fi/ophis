---
const SWAP_URL = 'https://swap.ophis.fi/#/swap'
---
<section class="hero" aria-labelledby="heroTitle">
  <div class="hero-inner">
    <p class="eyebrow reveal-up" data-reveal>Your next move starts here</p>
    <h1 class="serif reveal-up" id="heroTitle" data-reveal>Your assets.<br /><em>Your next move.</em></h1>
    <p class="lede reveal-up" data-reveal>A clearer way to swap. Choose your assets, review your limits, and keep control of every move.</p>
    <div class="ctas reveal-up" data-reveal>
      <a class="cta-primary" href={SWAP_URL}>Swap now</a>
      <a class="cta-secondary" href="#how">How it works</a>
    </div>
  </div>
</section>
<script>
  import '../lib/reveal.ts'
</script>

<style>
  .hero-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 64px 24px 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .hero .eyebrow { margin: 0 0 12px; }
  h1 {
    font-size: clamp(44px, 6.3vw, 90px);
    letter-spacing: -0.025em;
    margin: 0;
  }
  .hero .lede { margin: 12px 0 0; }
  .ctas { display: flex; gap: 12px; justify-content: center; margin-top: 28px; flex-wrap: wrap; }
  .cta-primary, .cta-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    min-height: 48px;
    padding: 12px 22px;
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    border: 1px solid transparent;
    white-space: nowrap;
  }
  .cta-primary { background: var(--ophis-saffron-60); color: #fff; }
  .cta-secondary { background: transparent; color: var(--ophis-fg); border-color: var(--ophis-border); }
  .cta-secondary:hover { background: var(--ophis-surface); }
  @media (max-width: 640px) {
    .hero-inner { padding: 44px 16px 16px; }
  }
</style>
