---
/* The Solana swap in one moving picture: SOL leaves the wallet on the left, the Ophis
   solver in the centre asks the six venues on the ring, one of them wins, and USDC
   arrives on the right. Every position is a percentage of the square and every size a
   container unit, so the picture scales with its column while the names stay readable.
   The loop is CSS only. The hidden checkbox pauses it (click, tap or Space), as on the
   home page; with reduced motion there is no loop and the resting picture is shown. */
const RING = 36.54 // ring radius, in % of the square
const point = (deg: number) => {
  const a = (deg * Math.PI) / 180
  return { x: 50 + RING * Math.cos(a), y: 50 + RING * Math.sin(a) }
}
const place = (deg: number, order: number) => {
  const { x, y } = point(deg)
  return `left:${x.toFixed(2)}%;top:${y.toFixed(2)}%;--i:${order}`
}

// `fill` marks a logo that comes as a full square and is shown as a disc, as on the home wall.
const venues = [
  { name: 'Raydium', logo: '/logos/protocols/raydium.png', deg: 225, fill: true },
  { name: 'Orca', logo: '/logos/protocols/orca.png', deg: 270, fill: true },
  { name: 'Meteora', logo: '/logos/protocols/meteora.png', deg: 315, fill: true },
  { name: 'PumpSwap', logo: '/logos/protocols/pumpswap.png', deg: 45, fill: false },
  { name: 'Jupiter', logo: '/logos/protocols/jupiter.png', deg: 90, fill: true },
  { name: 'Manifest', logo: '/logos/protocols/manifest.svg', deg: 135, fill: false },
].map((venue) => ({ ...venue, ...point(venue.deg) }))
---
<figure class="orbit" aria-label="A Solana swap on Ophis: SOL goes in, the Ophis solver prices five venues and can route through Jupiter, USDC comes out.">
  <input class="pause" id="orbitPause" type="checkbox" aria-label="Pause the animation" />
  <label class="stage" for="orbitPause">
    <span class="motion-help" aria-hidden="true">Tap, click or press Space to pause</span>
    <svg class="lines" viewBox="0 0 100 100" aria-hidden="true">
      <defs>
        <radialGradient id="orbitAura"><stop stop-color="#d4a68e" stop-opacity=".2" /><stop offset="1" stop-color="#d4a68e" stop-opacity="0" /></radialGradient>
        <linearGradient id="orbitIn" gradientUnits="userSpaceOnUse" x1="13.5" y1="50" x2="50" y2="50"><stop stop-color="#749cf4" /><stop offset="1" stop-color="#ca9174" /></linearGradient>
        <linearGradient id="orbitOut" gradientUnits="userSpaceOnUse" x1="50" y1="50" x2="86.5" y2="50"><stop stop-color="#ca9174" /><stop offset="1" stop-color="#8eab92" /></linearGradient>
      </defs>
      <circle cx="50" cy="50" r="49" fill="url(#orbitAura)" />
      <circle class="ring" cx="50" cy="50" r={RING} />
      {venues.map(({ x, y }, turn) => <line class="spoke" style={`--w:${turn}`} x1="50" y1="50" x2={x.toFixed(2)} y2={y.toFixed(2)} />)}
      <line class="flow" x1="13.46" y1="50" x2="50" y2="50" stroke="url(#orbitIn)" />
      <line class="flow" x1="50" y1="50" x2="86.54" y2="50" stroke="url(#orbitOut)" />
      {venues.map(({ x, y }, index) => <circle class="quote" r="0.9" style={`--x:${x.toFixed(2)}px;--y:${y.toFixed(2)}px;--i:${index}`} />)}
      <g class="packet packet-in"><circle r="4.3" /><image href="/logos/solana.svg" x="-3.3" y="-3.3" width="6.6" height="6.6" /></g>
      <g class="packet packet-out"><circle r="4.3" /><image href="/logos/swap-story/usdc.svg" x="-3.3" y="-3.3" width="6.6" height="6.6" /></g>
    </svg>

    <span class="hub"><img src="/logos/swap-story/ophis.svg" alt="Ophis" width="64" height="64" /></span>

    <span class="node token" style={place(180, 0)}>
      <span class="disc"><img src="/logos/solana.svg" alt="" width="66" height="66" /></span>
      <span class="name"><small>You sell</small>SOL</span>
    </span>
    {venues.map(({ name, logo, deg, fill }, index) => (
      <span class="node venue" style={`${place(deg, index + 1)};--w:${index}`}>
        <span class="disc"><img class:list={[{ fill }]} src={logo} alt={`${name} logo`} width="56" height="56" /></span>
        <span class="name">{name}</span>
      </span>
    ))}
    <span class="node token receive" style={place(0, venues.length + 1)}>
      <span class="disc"><img src="/logos/swap-story/usdc.svg" alt="" width="66" height="66" /></span>
      <span class="check" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m5 12 4 4 10-10" /></svg></span>
      <span class="name"><small>You receive</small>USDC</span>
    </span>
  </label>
</figure>

<style>
  .orbit { position: relative; margin: 0; width: 100%; max-width: 540px; container-type: inline-size; }
  .stage { position: relative; display: block; aspect-ratio: 1; }
  .lines { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .ring { fill: none; stroke: #cdb09c; stroke-width: 0.3; stroke-dasharray: 0.6 1.35; transform-box: fill-box; transform-origin: center; }
  .spoke { stroke: #e4dad3; stroke-width: 0.23; }
  .flow { fill: none; stroke-width: 0.7; stroke-linecap: round; }
  .quote { fill: #a86f50; opacity: 0; transform: translate(50px, 50px); }
  .packet { opacity: 0; transform: translate(50px, 50px); }
  .packet circle { fill: #fff; stroke: #dec9bc; stroke-width: 0.2; }
  /* The pause control: a checkbox that is there for the keyboard and for assistive
     technology, and the whole picture as its label. */
  .pause { position: absolute; width: 1px; height: 1px; margin: 0; opacity: 0; }
  .motion-help { display: none; }

  /* Sizes: pixels for a browser without container units, then a share of the picture. */
  .hub { --hub: 122px; }
  .node { --d: 56px; }
  .node.token { --d: 84px; }
  @media (max-width: 520px) {
    .hub { --hub: 84px; }
    .node { --d: 38px; }
    .node.token { --d: 58px; }
  }
  @supports (width: 1cqw) {
    .hub { --hub: 23.5cqw; }
    .node { --d: max(10.8cqw, 34px); }
    .node.token { --d: max(16cqw, 50px); }
  }

  .hub {
    position: absolute; left: 50%; top: 50%; width: var(--hub); height: var(--hub);
    transform: translate(-50%, -50%); border-radius: 50%; display: grid; place-items: center;
    background: radial-gradient(circle at 32% 22%, #fcebe1, #f4c7ac); border: 1px solid #dbbca7;
  }
  .hub img { width: 52%; height: 52%; display: block; }

  /* A node is a point; its disc is centred on it and its name hangs below. */
  .node { position: absolute; width: 0; height: 0; }
  .disc {
    position: absolute; left: 0; top: 0; width: var(--d); height: var(--d);
    transform: translate(-50%, -50%); border-radius: 50%; overflow: hidden;
    display: grid; place-items: center; background: var(--ophis-bg); border: 1px solid #e0d9d4;
  }
  .disc img { width: 62%; height: 62%; object-fit: contain; display: block; }
  .disc img.fill { width: 100%; height: 100%; object-fit: cover; }
  .token .disc { box-shadow: 0 7px 14px rgba(0, 0, 0, 0.14); }
  .token .disc img { width: 78%; height: 78%; }
  .name {
    position: absolute; left: 0; top: calc(var(--d) / 2 + 4px); transform: translateX(-50%);
    white-space: nowrap; font-size: 12.5px; line-height: 1.2; font-weight: 500; color: var(--ophis-fg-muted);
    /* A soft plate, so the ring never runs through a name. */
    padding: 2px 7px; border-radius: 9999px; background: rgba(255, 255, 255, 0.82);
  }
  .token .name { color: var(--ophis-fg); font-size: 14px; text-align: center; }
  .name small { display: block; font-size: 11.5px; font-weight: 400; color: var(--ophis-fg-faded); }
  .check {
    position: absolute; left: calc(var(--d) * 0.2); top: calc(var(--d) * -0.56);
    width: 24px; height: 24px; border-radius: 50%; display: grid; place-items: center;
    background: #d9e9de; color: #345840;
  }
  .check svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }

  @container (max-width: 400px) {
    .name, .token .name { font-size: 11.5px; }
    .name small { display: none; }
    .check { width: 20px; height: 20px; }
    .check svg { width: 12px; height: 12px; }
  }

  /* The loop, one swap every --t: the order travels to the solver, quotes go out to the
     six venues and come back, one venue wins (each in turn), USDC travels to the wallet
     and is confirmed. Positions inside the drawing are in its own units (0 to 100). */
  @media (prefers-reduced-motion: no-preference) {
    .orbit { --t: 5.2s; --start: 0.9s; }
    .stage { cursor: pointer; }
    .motion-help {
      display: block; position: absolute; left: 0; right: 0; top: -14px; text-align: center;
      font-size: 11px; color: var(--ophis-fg-faded); opacity: 0; transition: opacity 150ms ease; pointer-events: none;
    }
    .stage:hover .motion-help, .pause:focus-visible ~ .stage .motion-help, .pause:checked ~ .stage .motion-help { opacity: 1; }
    .pause:focus-visible ~ .stage { outline: 2px solid var(--ophis-brown); outline-offset: 6px; border-radius: 24px; }

    .node { animation: orbit-pop 420ms cubic-bezier(0.22, 1, 0.36, 1) both; animation-delay: calc(var(--i) * 70ms + 120ms); }
    .ring { animation: orbit-turn 90s linear infinite; }
    .packet-in { animation: orbit-in var(--t) linear var(--start) infinite; }
    .quote { animation: orbit-quote var(--t) ease-in-out calc(var(--start) + var(--i) * 45ms) infinite; }
    .hub { animation: orbit-think var(--t) ease-in-out var(--start) infinite; }
    .venue .disc { animation: orbit-win calc(var(--t) * 6) linear calc(var(--start) + var(--t) * var(--w)) infinite; }
    .spoke { animation: orbit-route calc(var(--t) * 6) linear calc(var(--start) + var(--t) * var(--w)) infinite; }
    .packet-out { animation: orbit-out var(--t) linear var(--start) infinite; }
    .receive .disc { animation: orbit-land var(--t) ease-out var(--start) infinite; }
    .check { animation: orbit-check var(--t) ease-out var(--start) infinite both; }
    .pause:checked ~ .stage, .pause:checked ~ .stage * { animation-play-state: paused; }
  }
  /* Nothing loops with reduced motion, so there is nothing to pause. */
  @media (prefers-reduced-motion: reduce) { .pause { display: none; } }
  @keyframes orbit-pop { from { opacity: 0; scale: 0.8; } }
  @keyframes orbit-turn { to { transform: rotate(360deg); } }
  @keyframes orbit-in {
    0% { transform: translate(13.46px, 50px); opacity: 0; }
    4%, 19% { opacity: 1; }
    21%, 100% { transform: translate(50px, 50px); opacity: 0; }
  }
  @keyframes orbit-quote {
    0%, 21% { transform: translate(50px, 50px); opacity: 0; }
    23% { opacity: 1; }
    39%, 43% { transform: translate(var(--x), var(--y)); opacity: 1; }
    57% { transform: translate(50px, 50px); opacity: 1; }
    59%, 100% { transform: translate(50px, 50px); opacity: 0; }
  }
  @keyframes orbit-think { 0%, 21%, 60%, 100% { scale: 1; } 40% { scale: 1.05; } }
  /* One sixth of this longer loop is a venue's own swap; it wins from about 60% to 92% of it. */
  @keyframes orbit-win {
    0%, 9.6%, 15.8%, 100% { box-shadow: 0 0 0 0 rgba(200, 150, 120, 0); }
    10.2%, 15.2% { box-shadow: 0 0 0 3px var(--ophis-peach), 0 0 0 4.5px #c89678; }
  }
  @keyframes orbit-route {
    0%, 9.6%, 15.8%, 100% { stroke: #e4dad3; stroke-width: 0.23; }
    10.2%, 15.2% { stroke: #aa7152; stroke-width: 0.5; }
  }
  @keyframes orbit-out {
    0%, 62% { transform: translate(50px, 50px); opacity: 0; }
    64%, 80% { opacity: 1; }
    82%, 100% { transform: translate(86.54px, 50px); opacity: 0; }
  }
  @keyframes orbit-land { 0%, 82%, 92%, 100% { translate: 0 0; } 86% { translate: 0 -5px; } }
  @keyframes orbit-check {
    0%, 82% { opacity: 0; scale: 0.6; }
    86%, 97% { opacity: 1; scale: 1; }
    100% { opacity: 0; scale: 1; }
  }
</style>
