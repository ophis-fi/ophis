---
// Logos are each partner's own official mark (in-repo SVG for CoW, official
// org marks for the rest), used for factual "built with" attribution.
// Bungee was dropped 2026-09-10: its API is permanently gone and the swap app
// no longer routes through it.
// Aleph Cloud was dropped 2026-11-26 (owner): the strip lists what a swap touches today.
const items = [
  { name: 'CoW Protocol',  note: 'Settlement stack we forked.',                  logo: '/logos/partners/cow-icon.svg' },
  { name: 'Trail of Bits', note: 'Security review tooling (Slither, Echidna).',  logo: '/logos/partners/trailofbits.png' },
  { name: 'NEAR Intents',  note: 'Swaps to and from Bitcoin and other networks.', logo: '/logos/partners/near.png' },
  { name: 'Across',        note: 'Cross-chain transfers between EVM networks.',  logo: '/logos/partners/across.svg' },
  { name: 'Relay',         note: 'More bridge routes between EVM networks.',     logo: '/logos/partners/relay.png' },
  { name: 'Circle CCTP',   note: 'Native USDC transfers to and from Arc.',       logo: '/logos/partners/circle.png' },
  { name: 'RAILGUN',       note: 'Private mode with shielded balances.',         logo: '/logos/partners/railgun.png' },
  { name: 'Safe',          note: 'Multisig trading through the Ophis Safe app.', logo: '/logos/partners/safe.svg' },
]
---
<section class="built-on">
  <div class="built-inner">
    <h2 class="serif reveal-up" data-reveal>
      Built with the tools and partners <em>that earned our trust.</em>
    </h2>
    <p class="sub reveal-up" data-reveal>
      Forked from CoW Protocol's settlement stack. Reviewed with Trail of Bits' open-source security tooling. Cross-chain routes through NEAR Intents, Across, Relay and Circle CCTP. Private mode through RAILGUN, multisig trading through Safe.
    </p>
    <div class="built-grid stagger">
      {items.map(item => (
        <div class="built-item reveal-up" data-reveal>
          <div class="built-head">
            <span class="built-logo">
              <img src={item.logo} alt={`${item.name} logo`} width="26" height="26" loading="lazy" decoding="async" />
            </span>
            <span class="built-name">{item.name}</span>
          </div>
          <span class="built-note">{item.note}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .built-on { padding: 80px 56px; text-align: center; }
  .built-inner { max-width: 1200px; margin: 0 auto; }
  h2 {
    font-size: 32px;
    margin: 0 0 12px;
  }
  .sub {
    color: var(--ophis-fg-muted);
    margin: 0 auto 48px;
    max-width: 680px;
    font-size: 15px;
    line-height: 1.6;
  }
  .built-grid {
    display: grid;
    /* minmax(0, 1fr) (not bare 1fr) lets columns shrink below the cards'
       min-content so they never force a row wider than the viewport. */
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    text-align: left;
  }
  .built-item {
    background: var(--ophis-surface);
    border: 1px solid var(--ophis-border);
    border-radius: var(--ophis-radius-sm);
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .built-head {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .built-logo {
    width: 38px;
    height: 38px;
    border-radius: 9px;
    background: #fff;
    display: grid;
    place-items: center;
    overflow: hidden;
    flex-shrink: 0;
    border: 1px solid var(--ophis-border);
  }
  .built-logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .built-name {
    font-weight: 600;
    font-size: 15px;
    color: var(--ophis-saffron-60);
  }
  .built-note {
    font-size: 13px;
    color: var(--ophis-fg-muted);
    line-height: 1.4;
  }
  @media (max-width: 1000px) {
    .built-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 720px) {
    h2 { font-size: 26px; }
  }
  /* Phones: drop the 56px side padding (it consumed 112px of a 320px viewport
     and forced horizontal page overflow) to match the .protocols breakpoint. */
  @media (max-width: 560px) {
    .built-on { padding: 64px 20px; }
    /* Eight stacked cards ran to a screen and a half. Each becomes one tight row:
       the logo on the left, the name and its line on the right. */
    .built-grid { grid-template-columns: 1fr; gap: 8px; }
    .built-item { display: grid; grid-template-columns: 38px 1fr; column-gap: 12px; row-gap: 0; align-items: center; padding: 10px 14px; }
    .built-head { display: contents; }
    .built-logo { grid-row: 1 / span 2; }
  }
</style>
