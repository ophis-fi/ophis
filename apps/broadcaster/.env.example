OPHIS_BROADCASTER_ENABLED=0
# Fresh installations stay unarmed. Unlock never enables sponsorship.
OPHIS_BROADCASTER_MODE=mainnet
# Public admission currently works on forks; mainnet remains blocked pending final release acceptance.
# Do not combine public admission with either PILOT_* restriction.
OPHIS_BROADCASTER_ADMISSION=pilot
OPHIS_BROADCASTER_RPC=http://100.69.134.7:8547
OPHIS_BROADCASTER_WAKU=http://127.0.0.1:8645
OPHIS_BROADCASTER_STATE=/var/lib/ophis-broadcaster
OPHIS_BROADCASTER_SECRETS=/var/lib/ophis-broadcaster/secrets/operator.sealed.json
# Public gas address from the verified encrypted migration; different from the Ledger treasury.
# OPHIS_BROADCASTER_OPERATOR_ADDRESS=0x...
OPHIS_BROADCASTER_PORT=4340
# Required for a restricted mainnet pilot; use the actual operator-bound deployment.
# OPHIS_BROADCASTER_EXECUTION_GUARD=0x...
# Only this owner-controlled ephemeral swap account may spend pilot gas. Public activation stays blocked.
# OPHIS_BROADCASTER_PILOT_ACCOUNT=0x...
# Optional one-time USDC withdrawal to this explicitly selected public recipient.
# OPHIS_BROADCASTER_PILOT_WITHDRAWAL_RECIPIENT=0x...
# Set explicit operator-approved limits in wei before enabling.
OPHIS_BROADCASTER_MAX_GAS_PRICE_WEI=0
OPHIS_BROADCASTER_MAX_TX_COST_WEI=0
OPHIS_BROADCASTER_DAILY_BUDGET_WEI=0
OPHIS_BROADCASTER_RESERVE_WEI=0
# Prepared rate: gas ceiling + 15%; change only to an explicitly chosen positive margin.
OPHIS_BROADCASTER_MARGIN_BPS=1500
