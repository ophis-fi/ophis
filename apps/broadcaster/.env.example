OPHIS_BROADCASTER_ENABLED=0
# Fresh installations stay unarmed. Unlock never enables sponsorship.
OPHIS_BROADCASTER_MODE=mainnet
OPHIS_BROADCASTER_CHAIN_ID=1
# One immutable chain per Compose project, state directory and Waku relay.
# Ethereum, BNB (56) and Arbitrum (42161) support native-prepaid public admission.
# Base (8453) remains pilot-only pending live inclusion; Polygon (137) is deferred.
# Never reuse Ethereum's wei caps for BNB or POL; each native currency needs explicit limits.
# Assign distinct OPHIS_WAKU_REST_PORT values when launching multiple projects on one host.
# Public mainnet admission requires the existing approved native credit ledger ID below.
# Do not combine public admission with either PILOT_* restriction.
OPHIS_BROADCASTER_ADMISSION=pilot
# Explicit fee model. The default preserves existing private-credit recovery.
# Set public-native only for a separately approved fresh ledger; never reuse or relabel a private ledger.
# Native credit comes from finalized public native-token payments to the existing operator address.
# Native refunds use the same operator nonce journal and reserve their gas plus margin from customer credit.
# public-native does not enable signing or remove the pilot/live-acceptance gates.
OPHIS_BROADCASTER_CREDIT_PAYMENT_MODE=private-wrapped
# Inspect the existing ledger without replacing it, then pin its nonzero 32-byte ID.
# Required for enabled public-native mainnet public admission; no calendar expiry.
# OPHIS_BROADCASTER_CREDIT_LEDGER_ID=0x...
OPHIS_BROADCASTER_RPC=http://100.69.134.7:8547
# Arbitrum/Base reads use chain-pinned Alchemy app RPC URLs in the private env file.
# Use an app RPC key, never an Alchemy account/admin access key. This does not enable signing.
# OPHIS_BROADCASTER_WRITE_RPC=https://arb-mainnet.g.alchemy.com/v2/APP_RPC_KEY
# Base WRITE_RPC must be https://mainnet-sequencer.base.org for conditional submission. No fallback is allowed.
OPHIS_BROADCASTER_WAKU=http://127.0.0.1:8645
OPHIS_BROADCASTER_STATE=/var/lib/ophis-broadcaster
OPHIS_BROADCASTER_SECRETS=/var/lib/ophis-broadcaster/secrets/operator.sealed.json
# Public gas address from the verified encrypted migration; different from the Ledger treasury.
# OPHIS_BROADCASTER_OPERATOR_ADDRESS=0x...
OPHIS_BROADCASTER_PORT=4340
# Required for a restricted mainnet pilot; use the actual operator-bound deployment.
# OPHIS_BROADCASTER_EXECUTION_GUARD=0x...
# Only this owner-controlled ephemeral swap account may spend pilot gas.
# OPHIS_BROADCASTER_PILOT_ACCOUNT=0x...
# Optional one-time USDC withdrawal to this explicitly selected public recipient.
# OPHIS_BROADCASTER_PILOT_WITHDRAWAL_RECIPIENT=0x...
# Set explicit operator-approved limits in wei before enabling.
OPHIS_BROADCASTER_MAX_GAS_PRICE_WEI=0
OPHIS_BROADCASTER_MAX_TX_COST_WEI=0
OPHIS_BROADCASTER_DAILY_BUDGET_WEI=0
OPHIS_BROADCASTER_RESERVE_WEI=0
# Prepared rate: gas ceiling + 15%; change only to an explicitly chosen positive margin.
OPHIS_BROADCASTER_MARGIN_BPS=1500
