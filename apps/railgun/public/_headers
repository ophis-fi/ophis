/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self' https: wss:; worker-src 'self' blob:; img-src 'self' data:; frame-src https://verify.walletconnect.org; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; form-action 'none'
  Referrer-Policy: no-referrer
