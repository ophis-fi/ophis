{
  "name": "@ophis/railgun",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9+sha512.f49b5a8ea0fdedb44bb3c0c1d6575092a53c2950d95b7ad15df11f17974877a2de3a01c07e934e9b28ce716e51c09a94962c7306d09be2e1e4b18a8c8762fd32",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4319 --strictPort",
    "build": "pnpm typecheck && vite build",
    "test": "vitest run",
    "test:fork": "RAILGUN_FORK_TEST=1 vitest run src/recipe.fork.test.ts src/cancel.fork.test.ts --no-file-parallelism",
    "test:wallet": "node tests/browser-wallet.mjs",
    "test:walletconnect": "node --env-file=.env.local tests/browser-walletconnect.mjs",
    "test:roundtrip": "node tests/fork-browser.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json"
  },
  "dependencies": {
    "@graphql-tools/utils": "9.2.1",
    "@railgun-community/curve25519-scalarmult-wasm": "0.1.5",
    "@railgun-community/engine": "9.9.1",
    "@railgun-community/poseidon-hash-wasm": "1.0.3",
    "@railgun-community/shared-models": "8.2.1",
    "@railgun-community/waku-broadcaster-client-web": "10.0.1",
    "@railgun-community/wallet": "11.2.0",
    "@walletconnect/ethereum-provider": "2.25.0",
    "ethers": "6.14.3",
    "level-js": "6.1.0",
    "levelup": "5.1.1",
    "qrcode-generator": "2.0.4",
    "snarkjs": "0.7.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261021.1",
    "@playwright/test": "1.64.1",
    "@types/level-js": "4.0.5",
    "@types/levelup": "5.1.5",
    "@types/node": "22.19.7",
    "@types/snarkjs": "0.7.9",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-node-polyfills": "0.24.0",
    "vitest": "4.1.12",
    "wrangler": "4.151.3"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "@railgun-community/waku-broadcaster-client-web@10.0.1>@railgun-community/wallet": "11.2.0"
      },
      "ignoreMissing": [
        "react-native"
      ]
    },
    "overrides": {
      "axios": "^1.20.0",
      "ws": "^8.21.0",
      "protobufjs": "^7.6.5",
      "@graphql-tools/executor-legacy-ws": "^1.1.36",
      "@railgun-community/circomlibjs@0.0.8>web3": "-",
      "bn.js@4.11.6": "4.12.5",
      "chai": "5.3.3",
      "follow-redirects": "^1.16.2",
      "minimatch@5": "^11.0.1",
      "underscore": "^1.13.8",
      "undici@7": "^7.30.1",
      "uuid@<11.1.1": "^11.1.1"
    },
    "patchedDependencies": {
      "elliptic@6.6.1": "../../patches/elliptic@6.6.1.patch",
      "@graphql-tools/utils@8.13.1": "patches/@graphql-tools__utils@8.13.1.patch",
      "@graphql-tools/utils@9.2.1": "patches/@graphql-tools__utils@9.2.1.patch",
      "@libp2p/peer-store@11.2.7": "patches/@libp2p__peer-store@11.2.7.patch",
      "@railgun-community/engine@9.9.1": "patches/@railgun-community__engine@9.9.1.patch",
      "zod@3.22.4": "../../patches/zod@3.22.4.patch",
      "zod@3.25.76": "../../patches/zod@3.25.76.patch"
    }
