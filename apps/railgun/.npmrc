strict-peer-dependencies=true
auto-install-peers=false
ignore-scripts=true
ignore-workspace=true
# 1-week delay (10080 min) before a new release can resolve. Set here, not in a
# pnpm-workspace.yaml: with ignore-workspace pnpm 10 skips workspace-yaml settings.
minimum-release-age=10080
# Reviewed security patch releases; the minimatch@5 override pins this line.
minimum-release-age-exclude[]=minimatch@11.0.4
minimum-release-age-exclude[]=@isaacs/nonrecursive-glob-match@1.0.3
