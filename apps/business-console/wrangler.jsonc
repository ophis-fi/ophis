{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "ophis-business-console",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-10-21",
  // The Worker runs first on every path: it decides by hostname which pages a host serves (the console, or the
  // signing page under /sign/). Console pages still take their headers from public/_headers.
  // ponytail: one Worker request per static file. Give the signing hostname its own Worker if that ever costs.
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true },
  // One hostname only (security-design.md section 1, condition 6).
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ophis-business",
      // Placeholder: local only so far. Create the real database with --jurisdiction=eu; it cannot be changed later.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  // No R2: past its free tier R2 bills (owner, 2026-11-17: nothing may cost money). The sealed items are in D1 (sealed_chunks).
  // Selects the constants in src/server/passkeys.ts. The relying-party id and origin are never read from a request.
  "vars": { "ENVIRONMENT": "local" },
  // M10: once a day the Worker reads the OFAC list file (SANCTIONS_URL; unset: nothing is read) and then the figures of the partners.
  "triggers": { "crons": ["17 3 * * *"] },
  "dev": { "ip": "127.0.0.1", "port": 8787 },
  // Production, decided 2026-11-14: the console on pro.ophis.fi, the signing page on sign.ophis.fi, one Worker
  // (ophis-business-console-production). Bindings and vars are not inherited, so they are repeated here.
  "env": {
    "production": {
      "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true },
      // The two names only: no workers.dev name, no preview names (repeated so that no default applies).
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        { "pattern": "pro.ophis.fi", "custom_domain": true },
        { "pattern": "sign.ophis.fi", "custom_domain": true },
        // The operator's API, behind Cloudflare Access (README, "The operator's address in production").
        { "pattern": "operator.ophis.fi", "custom_domain": true },
      ],
      // Created 2026-11-17 with --jurisdiction=eu (wrangler d1 list: "jurisdiction": "eu").
      "d1_databases": [{ "binding": "DB", "database_name": "ophis-business", "database_id": "c5d7d56e-ddd5-4788-8008-7089aa7f2a0b", "migrations_dir": "migrations" }],
      // SANCTIONS_URL stays unset: the OFAC list is loaded by hand once a month (README, "The OFAC list file").
      // Secrets: CHALLENGE_KEY, INDEXER_TOKEN, TYPESAFE_API_KEY, TURNSTILE_SECRET, OPERATOR_TOKEN (wrangler secret put --env production).
      // SEAL_RECIPIENT: the public recipient of the key ceremony (scripts/seal-ceremony.sh), generation g1, made on
      // 2026-11-16, fingerprint 9d1f8c22a7c3b24f89a3b191733196d2c2509ddec5357c83bbcbaa0ce3e15b8f; the same string as PRODUCTION in src/app/onboarding.tsx.
      // TURNSTILE (src/server/index.ts) gets the widget's public site key.
      // ACCESS_TEAM (the team's domain) and ACCESS_AUD (the AUD tag) are those of the Access application of
      // operator.ophis.fi. Both are public: the AUD is in every Access token. A renamed team or a recreated application
      // changes them; until they match it again, the operator's address refuses every request (onboarding.ts, accessOk).
      "vars": { "ENVIRONMENT": "production", "INDEXER_URL": "https://rebates.ophis.fi", "ACCESS_TEAM": "oclawd.cloudflareaccess.com", "ACCESS_AUD": "2390d7bef31c3a72b31f432568855e693ce97bc2fc0aca8020c5448e0c269e3e", "SEAL_RECIPIENT": "" },
    },
  },
}
