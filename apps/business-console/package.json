    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright-core": "1.64.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12",
    "wrangler": "4.156.2"
  }
}
