{
  "name": "@ophis/business-console",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9+sha512.f49b5a8ea0fdedb44bb3c0c1d6575092a53c2950d95b7ad15df11f17974877a2de3a01c07e934e9b28ce716e51c09a94962c7306d09be2e1e4b18a8c8762fd32",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "vite build && vite build --mode sign",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "migrate": "wrangler d1 migrations apply DB --local",
    "seed": "node scripts/dev.mjs seed",
    "activate": "node scripts/dev.mjs activate",
    "skip": "node scripts/dev.mjs skip",
    "dev": "vite build && vite build --mode sign && node scripts/stubs.mjs wrangler dev",
    "tour": "vite build && vite build --mode sign && node scripts/tour.mjs",
    "operator": "node scripts/operator.mjs",
    "test": "vite build && vite build --mode sign && vitest run",
    "test:chain": "node tests/chain.mjs",
    "test:jev": "node tests/jev.mjs",
    "test:age": "node tests/age.mjs",
    "test:cpu": "node tests/cpu.mjs",
    "test:e2e": "vite build && vite build --mode sign && node tests/e2e.mjs"
  },
  "dependencies": {
    "@safe-global/safe-apps-sdk": "9.1.0",
    "@simplewebauthn/server": "14.0.3",
    "@walletconnect/sign-client": "2.25.0",
    "age-encryption": "0.3.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "viem": "2.57.16"
  },
  "pnpm": {
    "patchedDependencies": {
      "picomatch@2.3.2": "../../patches/picomatch@2.3.2.patch",
      "picomatch@4.0.7": "../../patches/picomatch@4.0.7.patch"
    }
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.5.0",
    "@cloudflare/workers-types": "5.20261102.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright-core": "1.64.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12",
    "wrangler": "4.156.2"
  }
}
