{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ophis-compat",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-01",
  "observability": {
    "enabled": true
  },
  // Per-IP rate limit for the public compat endpoints (60 requests / 60s, per
  // colo), mirroring the mcp-server posture. Best-effort abuse cap; combined
  // with the request body cap it closes the amplification path toward the
  // orderbook. Local `wrangler dev` treats this as a no-op.
  "unsafe": {
    "bindings": [
      {
        "name": "COMPAT_RATE_LIMIT",
        "type": "ratelimit",
        "namespace_id": "1002",
        "simple": { "limit": 60, "period": 60 }
      }
    ]
  },
  // Enabled chains for the compat surface (Ophis-operated orderbooks only, so
  // nothing proxies api.cow.fi hosts). Everything else stays behind this config.
  "vars": {
    "COMPAT_ENABLED_CHAINS": "10,130",
    // Master switch for mapping a non-zero Odos `referralFee` to a CIP-75 Volume
    // `metadata.partnerFee` entry (partner-fees Phase A, #926). MUST be flipped
    // in lockstep with the backend's `partner-fee-registry.registration-enabled`:
    // while the backend program is off, an unregistered recipient's order is
    // rejected at ingress, so the safer default is to reject the fee here rather
    // than mint a draft that fails at submit. Ships off.
    "COMPAT_PARTNER_FEE_ENABLED": "false",
    // Typical quote-to-settlement latency (seconds), surfaced as
    // `ophis.expectedSettlementSeconds` (Mode B1). Default 24 is derived from the
    // OP autopilot run-loop (20 s solve-deadline + ~2 blocks confirmation);
    // replace with a measured value as settlement telemetry accrues. An estimate,
    // never a guarantee.
    "COMPAT_SETTLEMENT_BASELINE_SECONDS": "24"
  },
  // Custom domain (owner decision 6: compat.ophis.fi isolates the shim and
  // keeps a cheap exit later). Provisioned by wrangler on deploy: the ophis.fi
  // zone lives in this CF account, same mechanism as mcp.ophis.fi. First
  // deploy also needs the COMPAT_PATHID_KEY secret (see the deploy runbook in
  // the introducing PR): `wrangler secret put COMPAT_PATHID_KEY`.
  "routes": [{ "pattern": "compat.ophis.fi", "custom_domain": true }]
}
