{
  "name": "@ophis/plugin-goat",
  "version": "0.3.8",
  "description": "GOAT SDK plugin for Ophis ERC-20 swaps, with partner fees and optional referral attribution.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ophis-fi/ophis.git",
    "directory": "packages/plugin-goat"
  },
  "homepage": "https://docs.ophis.fi/ai-agents",
  "bugs": "https://github.com/ophis-fi/ophis/issues",
  "keywords": [
    "ophis",
    "goat-sdk",
    "goat",
    "ai-agent",
    "agent",
    "swap",
    "defi",
    "rebate"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "pretest": "pnpm --filter @ophis/sdk build && pnpm --filter @ophis/agent-swap build && pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@ophis/agent-swap": "workspace:*",
    "viem": "^2.21.0"
  },
  "peerDependencies": {
    "@goat-sdk/core": "0.5.0",
    "@goat-sdk/wallet-evm": "0.3.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@goat-sdk/core": "0.5.0",
    "@goat-sdk/wallet-evm": "0.3.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.12",
    "zod": "^4.6.6"
  }
}
